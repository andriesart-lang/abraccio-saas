# Configurazione Preventivo AI SaaS
# Inserisci le tue chiavi quando andrai in produzione:

# Google Gemini API Key (la tua chiave backend che alimenta il servizio per tutti gli utenti abbonati)
GEMINI_API_KEY=

# Stripe (crea un account gratuito su dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_MONTHLY=price_placeholder

# JWT Secret per autenticazione utenti (puoi generare qualsiasi stringa casuale)
JWT_SECRET=super_secret_jwt_key_saas_2026_preventivo_apple_style

# Limite preventivi per account Free (senza abbonamento)
FREE_QUOTES_LIMIT=3

# URL base
APP_URL=http://localhost:8000
